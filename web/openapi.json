{
  "openapi": "3.1.1",
  "info": {
    "title": "rung-host | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5580/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Rung"
        ],
        "summary": "网关整体健康状况",
        "description": "有设备掉线时 status 为 degraded。适合直接接监控探针。",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthView"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices": {
      "get": {
        "tags": [
          "Rung"
        ],
        "summary": "全部设备的运行状况",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/devices/{deviceId}": {
      "get": {
        "tags": [
          "Rung"
        ],
        "summary": "单台设备的运行状况",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/tags": {
      "get": {
        "tags": [
          "Rung"
        ],
        "summary": "点位最新值",
        "description": "可用 device 与 prefix 过滤。prefix 按业务名前缀匹配。",
        "parameters": [
          {
            "name": "device",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TagView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tags/{tagName}": {
      "get": {
        "tags": [
          "Rung"
        ],
        "summary": "单个点位的最新值",
        "parameters": [
          {
            "name": "tagName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TagView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/tags/{tagName}/write": {
      "post": {
        "tags": [
          "Rung"
        ],
        "summary": "写入点位",
        "description": "值按点位声明的数据类型解释。写完会记审计日志，并回读设备上的真实值。 路径上显式写出 write 而不是用 PUT：这个动作会让产线上的机器真的动起来， 一眼看得出比符合 REST 惯例更重要。",
        "parameters": [
          {
            "name": "tagName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WriteTagRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TagView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/stream/tags": {
      "get": {
        "tags": [
          "Rung"
        ],
        "summary": "点位变化的实时推送（SSE）",
        "description": "只推送越过死区的变化。浏览器用 EventSource 订阅，自带断线重连。",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/SseItemOfTagView"
                }
              }
            }
          }
        }
      }
    },
    "/api/config/reload": {
      "post": {
        "tags": [
          "Rung"
        ],
        "summary": "从配置源重新加载",
        "description": "只有配置真的变了的设备会被重启，其余原地继续跑，采集不中断。 校验失败时配置原封不动，不会留下一个改了一半的网关。",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReloadView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/audit": {
      "get": {
        "tags": [
          "Rung"
        ],
        "summary": "最近的写操作审计",
        "description": "谁、什么时候、往哪个点位写了什么值，以及设备回读到的实际值。 失败的尝试同样留痕。",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WriteAuditRecord"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "tags": [
          "Rung 配置"
        ],
        "summary": "当前配置摘要",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigSummaryView"
                }
              }
            }
          }
        }
      }
    },
    "/api/config/export": {
      "get": {
        "tags": [
          "Rung 配置"
        ],
        "summary": "导出点位表为 Excel",
        "description": "导出的文件改完可以直接上传回来。",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/config/validate": {
      "post": {
        "tags": [
          "Rung 配置"
        ],
        "summary": "只校验上传的配置，不写入",
        "description": "上传 .xlsx 或 .json，逐行报出问题。不改变任何现有配置。",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigCheckView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/config/import": {
      "post": {
        "tags": [
          "Rung 配置"
        ],
        "summary": "导入配置并立即生效",
        "description": "上传 .xlsx 或 .json。先校验，有问题就整份拒绝；通过之后写入并在线重载，只有配置真的变了的设备会被重启。",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfigCheckView": {
        "required": [
          "devices",
          "duplicateTagNames",
          "fileIssues",
          "tagCount",
          "requestCount",
          "problemCount"
        ],
        "type": "object",
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceCheckView"
            },
            "description": "逐设备结果。"
          },
          "duplicateTagNames": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "跨设备重复的点位名。"
          },
          "fileIssues": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "解析文件时逐行发现的问题（仅 Excel）。"
          },
          "tagCount": {
            "type": "integer",
            "description": "点位总数。",
            "format": "int32"
          },
          "requestCount": {
            "type": "integer",
            "description": "每轮请求总数。",
            "format": "int32"
          },
          "problemCount": {
            "type": "integer",
            "description": "问题总数。",
            "format": "int32"
          }
        },
        "description": "整份配置的校验结果。"
      },
      "ConfigSummaryView": {
        "required": [
          "source",
          "writable",
          "deviceCount",
          "tagCount"
        ],
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "来源描述。"
          },
          "writable": {
            "type": "boolean",
            "description": "是否可在线修改。JSON 文件来源为只读。"
          },
          "deviceCount": {
            "type": "integer",
            "description": "设备数。",
            "format": "int32"
          },
          "tagCount": {
            "type": "integer",
            "description": "点位数。",
            "format": "int32"
          }
        },
        "description": "配置来源摘要。"
      },
      "DeviceCheckView": {
        "required": [
          "deviceId",
          "protocol",
          "tagCount",
          "requestCount",
          "issues"
        ],
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "description": "设备标识。"
          },
          "protocol": {
            "type": "string",
            "description": "协议。"
          },
          "tagCount": {
            "type": "integer",
            "description": "点位数。",
            "format": "int32"
          },
          "requestCount": {
            "type": "integer",
            "description": "每轮请求次数。",
            "format": "int32"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagIssueView"
            },
            "description": "配置问题。"
          }
        },
        "description": "一台设备的校验结果。"
      },
      "DeviceView": {
        "required": [
          "deviceId",
          "state",
          "lastSuccessUtc",
          "lastFailureUtc",
          "lastError",
          "consecutiveFailures",
          "reconnectCount",
          "lastPollMs",
          "maxFrameBytes",
          "activeTagCount",
          "requestCount",
          "overrunCount",
          "issues"
        ],
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "description": "设备标识。"
          },
          "state": {
            "type": "string",
            "description": "连接状态。"
          },
          "lastSuccessUtc": {
            "type": [
              "null",
              "string"
            ],
            "description": "最近一次成功采集时刻。",
            "format": "date-time"
          },
          "lastFailureUtc": {
            "type": [
              "null",
              "string"
            ],
            "description": "最近一次失败时刻。",
            "format": "date-time"
          },
          "lastError": {
            "type": [
              "null",
              "string"
            ],
            "description": "最近一次错误描述。"
          },
          "consecutiveFailures": {
            "type": "integer",
            "description": "连续失败次数。",
            "format": "int32"
          },
          "reconnectCount": {
            "type": "integer",
            "description": "累计重连次数。",
            "format": "int32"
          },
          "lastPollMs": {
            "type": "number",
            "description": "上一轮采集耗时，毫秒。",
            "format": "double"
          },
          "maxFrameBytes": {
            "type": "integer",
            "description": "单次报文的最大字节数。S7 是协商出来的，其余协议是写死的上限。",
            "format": "int32"
          },
          "activeTagCount": {
            "type": "integer",
            "description": "参与采集的点位数。",
            "format": "int32"
          },
          "requestCount": {
            "type": "integer",
            "description": "每轮请求次数。",
            "format": "int32"
          },
          "overrunCount": {
            "type": "integer",
            "description": "采集超时次数。",
            "format": "int32"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagIssueView"
            },
            "description": "配置有问题的点位。"
          }
        },
        "description": "一台设备的对外状况。"
      },
      "HealthView": {
        "required": [
          "status",
          "deviceCount",
          "connectedCount",
          "tagCount",
          "issueCount",
          "uptimeSeconds"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "healthy / degraded。有设备掉线即为 degraded。"
          },
          "deviceCount": {
            "type": "integer",
            "description": "设备总数。",
            "format": "int32"
          },
          "connectedCount": {
            "type": "integer",
            "description": "已连接的设备数。",
            "format": "int32"
          },
          "tagCount": {
            "type": "integer",
            "description": "缓存中的点位数。",
            "format": "int32"
          },
          "issueCount": {
            "type": "integer",
            "description": "配置有问题的点位总数。",
            "format": "int32"
          },
          "uptimeSeconds": {
            "type": "number",
            "description": "运行时长，秒。",
            "format": "double"
          }
        },
        "description": "网关整体健康状况。"
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "ImportView": {
        "required": [
          "devices",
          "added",
          "restarted",
          "removed",
          "unchanged"
        ],
        "type": "object",
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceCheckView"
            },
            "description": "导入的设备校验结果。"
          },
          "added": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "新启动的设备。"
          },
          "restarted": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "被重启的设备。"
          },
          "removed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "被移除的设备。"
          },
          "unchanged": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "原地继续跑的设备。"
          }
        },
        "description": "导入并生效的结果。"
      },
      "JsonElement": { },
      "ReloadView": {
        "required": [
          "source",
          "added",
          "restarted",
          "removed",
          "unchanged"
        ],
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "配置来源描述。"
          },
          "added": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "新启动的设备。"
          },
          "restarted": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "配置变了、被重启的设备。"
          },
          "removed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "被移除的设备。"
          },
          "unchanged": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "配置未变、原地继续跑的设备。"
          }
        },
        "description": "一次配置重载的结果。"
      },
      "SseItemOfTagView": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TagView"
          },
          "eventType": {
            "type": [
              "null",
              "string"
            ]
          },
          "eventId": {
            "type": [
              "null",
              "string"
            ]
          },
          "reconnectionInterval": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TagIssueView": {
        "required": [
          "tagName",
          "reason"
        ],
        "type": "object",
        "properties": {
          "tagName": {
            "type": "string",
            "description": "点位名。"
          },
          "reason": {
            "type": "string",
            "description": "原因，应当足以让电气工程师自己改对。"
          }
        },
        "description": "一个点位的配置问题。"
      },
      "TagView": {
        "required": [
          "name",
          "value",
          "quality",
          "timestampUtc",
          "deviceId",
          "address",
          "dataType",
          "description"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "业务点位名。"
          },
          "value": {
            "description": "当前值。质量不佳时为 null。"
          },
          "quality": {
            "type": "string",
            "description": "采集质量。"
          },
          "timestampUtc": {
            "type": "string",
            "description": "采集时刻，UTC。",
            "format": "date-time"
          },
          "deviceId": {
            "type": "string",
            "description": "来源设备。"
          },
          "address": {
            "type": "string",
            "description": "协议地址，便于现场核对。"
          },
          "dataType": {
            "type": "string",
            "description": "数据类型。"
          },
          "description": {
            "type": [
              "null",
              "string"
            ],
            "description": "描述。"
          }
        },
        "description": "    一个点位的对外表示。\n    刻意不暴露 TagValue 本身：它是为热路径设计的紧凑结构体，\n换成 JSON 友好的形状之后，接口契约才能独立于内部实现演进。"
      },
      "WriteAuditRecord": {
        "required": [
          "timestampUtc",
          "caller",
          "deviceId",
          "tagName",
          "address",
          "dataType",
          "requested",
          "actual",
          "success",
          "error"
        ],
        "type": "object",
        "properties": {
          "timestampUtc": {
            "type": "string",
            "description": "操作时刻，UTC。",
            "format": "date-time"
          },
          "caller": {
            "type": "string",
            "description": "调用方名称，来自 API 密钥。"
          },
          "deviceId": {
            "type": "string",
            "description": "设备标识。"
          },
          "tagName": {
            "type": "string",
            "description": "业务点位名。"
          },
          "address": {
            "type": "string",
            "description": "协议地址。排障时手头只有审计文件也能直接看懂。"
          },
          "dataType": {
            "type": "string",
            "description": "数据类型。拆成独立字段而不是拼进值里——\n            选 JSON Lines 就是为了机器也能解析，让消费方去拆 \"266 [Float64]\" 这种复合串\n            是把方便留给自己、麻烦留给别人。"
          },
