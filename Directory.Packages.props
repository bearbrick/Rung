<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Runtime">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Configuration">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <!-- 点位表导入导出。比 ClosedXML 轻一个数量级，且不依赖 Office -->
    <PackageVersion Include="MiniExcel" Version="1.45.0" />
  </ItemGroup>

  <ItemGroup Label="Web">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />

    <!--
      传递依赖钉版本：Microsoft.AspNetCore.OpenApi 10.0.10 带的 Microsoft.OpenApi 2.0.0
      存在高危漏洞 GHSA-v5pm-xwqc-g5wc（循环 schema 引用会终止解析），2.7.5 起修复。
      CentralPackageTransitivePinningEnabled 让这里的声明能覆盖传递版本。
      升级 AspNetCore.OpenApi 之后记得回来确认这条还需不需要。
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.0" />
  </ItemGroup>

  <ItemGroup Label="Sinks">
    <PackageVersion Include="StackExchange.Redis" Version="3.1.13" />
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <!-- MQTTnet 5 起服务端拆成独立包。只有测试用得到：
         开发机上不必装 broker 就能端到端验证 -->
    <PackageVersion Include="MQTTnet.Server" Version="5.2.0.1603" />
  </ItemGroup>

  <ItemGroup Label="Drivers">
    <!-- Modbus 不从 IoTClient 移植：FluentModbus 原生 async、MIT、且自带 Server 便于集成测试 -->
    <PackageVersion Include="FluentModbus" Version="5.3.2" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

</Project>
