        { "name": "Line4.Pack.Running", "address": "D300.00", "dataType": "Bool",
          "description": "输送带运行" },
        { "name": "Line4.Pack.LowMaterial", "address": "D300.05", "dataType": "Bool",
          "description": "缺料报警" }
      ]
    },
    {
      "deviceId": "line3-injection",
      "protocol": "melsec-mc",
      "host": "127.0.0.1",
      "port": 16000,
      "tags": [
        { "name": "Line3.Inj.Temp", "address": "D100", "dataType": "Int16",
