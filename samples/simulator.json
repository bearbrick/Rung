{
  "version": 1,
  "redis": {
    "enabled": true,
    "port": 16379
  },
  "devices": [
    {
      "name": "line1-oven",
      "port": 10102,
      "negotiatedPduLength": 240,
      "signals": [
        {
          "address": "DB1.DBW0", "type": "Int16",
          "generator": "sine", "min": 2200, "max": 2500, "periodSeconds": 40,
          "description": "炉温，PLC 里存放大 10 倍的整数"
        },
        {
          "address": "DB1.DBD4", "type": "Float32",
          "generator": "randomwalk", "min": 1010, "max": 1016, "step": 0.15, "periodSeconds": 1,
          "description": "腔压，随机游走"
        },
        {
          "address": "DB1.DBX8.0", "type": "Bool",
          "generator": "toggle", "periodSeconds": 12,
          "description": "运行状态"
        },
        {
          "address": "DB1.DBD10", "type": "Int32",
          "generator": "counter", "value": 128000, "step": 3, "periodSeconds": 2,
          "description": "产量计数"
        },
        {
          "address": "DB1.DBW20", "type": "Int16",
          "generator": "constant", "value": 2400,
          "description": "温度设定值，可写且写入后保留"
        }
      ]
    },
    {
      "name": "line1-robot",
      "port": 10103,
      "negotiatedPduLength": 480,
      "signals": [
        {
          "address": "DB10.DBD0", "type": "Float32",
          "generator": "ramp", "min": 0, "max": 360, "periodSeconds": 8,
          "description": "关节角度"
        },
        {
          "address": "DB10.DBD4", "type": "Int32",
          "generator": "counter", "value": 0, "step": 1, "periodSeconds": 3,
          "description": "循环次数"
        },
        {
          "address": "M0.0", "type": "Bool",
          "generator": "toggle", "periodSeconds": 5,
          "description": "抓手状态"
        }
      ]
    },
    {
      "name": "line2-flaky",
      "port": 10104,
      "negotiatedPduLength": 240,
      "signals": [
        {
          "address": "DB1.DBW0", "type": "Int16",
          "generator": "counter", "value": 0, "step": 1, "periodSeconds": 1,
          "description": "一台会周期性掉线的设备，用来验证重连"
        }
      ],
      "faults": {
        "dropEverySeconds": 15
      }
    }
  ],
  "modbusDevices": [
    {
      "name": "line2-meter",
      "port": 10502,
      "unitIds": [1, 2],
      "signals": [
        {
          "address": "HR0", "type": "Float32",
          "generator": "sine", "min": 380, "max": 400, "periodSeconds": 25,
          "description": "线电压 V"
        },
        {
          "address": "HR2", "type": "Float32",
          "generator": "randomwalk", "min": 40, "max": 60, "step": 0.4, "periodSeconds": 1,
          "description": "有功功率 kW"
        },
        {
          "address": "HR10", "type": "Int32",
          "generator": "counter", "value": 500000, "step": 2, "periodSeconds": 1,
          "description": "累计电量 kWh"
        },
        {
          "address": "CO0", "type": "Int16",
          "generator": "toggle", "periodSeconds": 7,
          "description": "合闸状态"
        },
        {
          "address": "2:HR0", "type": "Int16",
          "generator": "counter", "value": 0, "step": 1, "periodSeconds": 3,
          "description": "二号从站的计数器"
        }
      ]
    }
  ]
}
