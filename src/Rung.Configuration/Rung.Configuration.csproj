<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Rung.Configuration</PackageId>
    <Description>Rung 的配置模型与加载。CLI 与 Host 共用，将来 SQLite 配置存储也落在这里。</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="MiniExcel" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rung.Abstractions\Rung.Abstractions.csproj" />
    <ProjectReference Include="..\Rung.Core\Rung.Core.csproj" />
  </ItemGroup>

</Project>
